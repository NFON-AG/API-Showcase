# Call History API Showcase
# API Reference: https://github.com/NFON-AG/Call-History-API

# REQUIRED
# Local Server Setup
# Bind address. Keep 127.0.0.1 to only listen locally.
HOST=127.0.0.1
PORT=3000
CALLHISTORY_ALLOWED_ORIGIN=http://localhost:3000

# REQUIRED
# OAuth / Login with NFON
# The app uses OAuth 2.0 (PKCE) to authenticate users against the NFON identity provider.
CALLHISTORY_AUTH_URL=https://sso.cloud-cfg.com/realms/login/protocol/openid-connect/auth
CALLHISTORY_TOKEN_URL=https://sso.cloud-cfg.com/realms/login/protocol/openid-connect/token
# Your registered OAuth client ID
CALLHISTORY_CLIENT_ID=
# Must match the redirect URI registered for your client
CALLHISTORY_REDIRECT_URI=http://localhost:3000
# Public URL the browser uses to reach this app
CALLHISTORY_PUBLIC_BASE_URL=http://localhost:3000
CALLHISTORY_SCOPE=openid profile email basic

# REQUIRED
# Call History API endpoints
CALLHISTORY_API_BASE_URL=https://start.cloudya.com/api/callhistory
CALLHISTORY_CALLS_PATH=/records
CALLHISTORY_RECORD_DETAILS_PATH=/records/{uuid}
# Max records per page (integer, 1–500).
CALLHISTORY_LIMIT=100
# Maximum loaded records (integer, 1–100000); a partial-result warning appears if reached.
CALLHISTORY_MAX_RECORDS=10000
# Maximum list-page requests, including authentication retries (1–1000).
CALLHISTORY_MAX_REQUESTS=100
# Timeout per upstream request, in milliseconds (integer, 100–2147483647).
CALLHISTORY_TIMEOUT_MS=15000
# Total budget for paged retrieval, including token refresh, in milliseconds (integer, 250–60000).
CALLHISTORY_PAGING_BUDGET_MS=30000

# OPTIONAL
# Local development helpers
# Optional persisted-data directory; default is the app data folder under the external config directory, or ./data.
CALLHISTORY_DATA_DIR=
# When true, the app serves demo data without calling the real API.
DEMO_MODE=false

# OPTIONAL
# Manual token override — only for temporary local debugging.
# Prefer the OAuth login flow for normal usage.
# CALLHISTORY_ACCESS_TOKEN=
# CALLHISTORY_REFRESH_TOKEN=
