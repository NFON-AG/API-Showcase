# Landing Page / Cockpit
# Central hub that routes to the individual showcase apps and optionally
# manages their lifecycle (start/stop) in the local monorepo setup.

# REQUIRED
# Local Server Setup
PORT=3010
# Bind address. Keep 127.0.0.1 to only listen locally.
LANDING_HOST=127.0.0.1
# Origin allowed for CORS requests. Must match how you access the app in the browser.
LANDING_ALLOWED_ORIGIN=http://localhost:3010

# OPTIONAL
# Service control — disabled by default for standalone/release safety.
# Set to true only for the local monorepo cockpit when this app should
# start/stop sibling showcase servers.
LANDING_ENABLE_SERVICE_CONTROL=true

# OPTIONAL
# Upstream overrides for the all-in-one cockpit.
# These define where each sub-app is reachable. The defaults match the
# standard ports used by each app when started individually.
CTI_UPSTREAM=http://127.0.0.1:3002
PORTAL_UPSTREAM=http://127.0.0.1:3001
CORE_HISTORY_UPSTREAM=http://127.0.0.1:3000
