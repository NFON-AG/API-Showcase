# Build artifacts & logs
coverage/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local verification output
output/playwright/
output/independent-v12-audit-2026-11-04/
.playwright-cli/

# Local service ownership and logs contain runtime credentials/metadata.
landing-services.json
**/logs/
