# CTI API Showcase
# API Reference: https://github.com/NFON-AG/CTI-API

# REQUIRED
# Local Server Setup
# Bind address. Keep 127.0.0.1 to only listen locally.
HOST=127.0.0.1
PORT=3002
# Base URL of the CTI API
NFON_BASE_URL=https://providersupportdata.cloud-cfg.com/v1
CTI_ALLOWED_ORIGIN=http://localhost:3002

# REQUIRED
# CTI API Credentials
# Your K-Account identifier
NFON_K_ACCOUNT=your-k-account
# Your CTI API username
NFON_API_USERNAME=your-api-user
# Your CTI API password
NFON_API_PASSWORD=change-me

# OPTIONAL
# External secrets file — an alternative to storing credentials directly above.
# Point this to a local file OUTSIDE the project directory to avoid accidentally
# committing secrets. The file should contain: <account> <password>
# Example: NFON_SECRET_FILE=~/.config/nfon-api-showcase/secrets/CTI_API/secret.txt
# If NFON_API_USERNAME and NFON_API_PASSWORD are already set, this is not needed.
NFON_SECRET_FILE=

# OPTIONAL
# Google Contacts lookup for call popups and contact context.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same idea as NFON_SECRET_FILE — path to a local file with the Google client secret.
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_REDIRECT_URI=http://localhost:3002/auth/google/callback

# OPTIONAL
# Remote access flags — both default to false and should stay that way for normal
# local usage. Only set to true if you intentionally want another machine in a
# trusted network (e.g. behind a secured proxy) to access this instance.

# When true, remote clients can trigger actions like Click-to-Dial or Sync/Restore.
CTI_ALLOW_REMOTE_CONTROL=false

# When true, remote clients can read private data (contacts, call events, history, backups).
CTI_ALLOW_REMOTE_READ=false

# OPTIONAL
# Directory for persisted data (call events, backups). Defaults to ./data.
CTI_DATA_DIR=
