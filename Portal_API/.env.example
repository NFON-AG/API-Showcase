# Service Portal API Showcase
# API Reference: https://github.com/NFON-AG/Service-Portal-API

# REQUIRED
# Local Server Setup
# Bind address. Keep 127.0.0.1 to only listen locally.
HOST=127.0.0.1
PORT=3001
PORTAL_ALLOWED_ORIGIN=http://localhost:3001

# REQUIRED
# Portal API Credentials
# Authentication uses HMAC request signing with the key pair below.
PORTAL_BASE_URL=https://portal-api.nfon.net:8090
# Your Portal API key ID
PORTAL_API_KEY_ID=
# Your Portal API key secret
PORTAL_API_KEY_SECRET=
# The customer account (K-Account) to manage
PORTAL_CUSTOMER_ACCOUNT=

# OPTIONAL
# External secrets files — an alternative to storing credentials directly above.
# Point these to local files OUTSIDE the project directory to avoid accidentally
# committing secrets.
# Example: PORTAL_SECRET_FILE=~/.config/nfon-api-showcase/secrets/Portal_API/secret.txt
# If the credentials above are already set, these are not needed.
PORTAL_SECRET_FILE=
NFON_SECRET_FILE=

# OPTIONAL
# Google Contacts file — path to a local JSON export of Google Contacts
# used for phonebook sync demonstrations.
PORTAL_GOOGLE_CONTACTS_FILE=

# OPTIONAL
# Directory for persisted data. Defaults to ./data.
PORTAL_DATA_DIR=

# OPTIONAL
# Live write protection — both default to false.
# Accepted booleans: true/false, 1/0, yes/no, on/off (case insensitive).
# Empty or unsupported values abort startup; omitted values use the defaults.
# Optional export prefixes and unquoted # comments are supported.
# PORTAL_ENABLE_LIVE_WRITES=true makes the Setup switch available.
# Every server start/restart remains read-only until live writes are explicitly
# switched on in Setup for the current server session.
# PORTAL_DISABLE_LIVE_WRITES acts as a hard block — when true, writes are
# rejected regardless of the enable flag.
# For normal local exploration, leave both at false (read-only mode).
PORTAL_ENABLE_LIVE_WRITES=false
PORTAL_DISABLE_LIVE_WRITES=false
